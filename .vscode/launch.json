    "version": "0.2.0",
    "configurations": [
      {
        "name": "Make Migrations",
        "type": "python",
        "request": "launch",
        "python": "${workspaceFolder}/.venv/bin/python",
        "program": "${workspaceFolder}/orman/manage.py",
        "args": ["makemigrations", "music"],
        "cwd": "${workspaceFolder}/orman",
        "django": true,
        "justMyCode": true
      },
      {
        "name": "Run Migrations",
        "type": "python",
        "request": "launch",
        "python": "${workspaceFolder}/.venv/bin/python",
        "program": "${workspaceFolder}/orman/manage.py",
        "args": ["migrate"],
        "django": true,
        "justMyCode": true
      },
      {
        "name": "Runserver",
        "type": "python",
        "request": "launch",
        "python": "${workspaceFolder}/.venv/bin/python",
        "program": "${workspaceFolder}/orman/manage.py",
        "args": ["runserver"],
        "django": true,
        "justMyCode": true
      }
    ]
  }