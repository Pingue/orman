{
  "name": "theme",
  "version": "3.6.0",
  "description": "",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run build:clean && npm run build:tailwind",
    "build:clean": "rimraf ../static/css/dist",
    "build:tailwind": "cross-env NODE_ENV=production npm exec -- tailwindcss -i ./src/styles.css -o ../static/css/dist/styles.css --minify",
    "dev": "cross-env NODE_ENV=development npm exec -- tailwindcss -i ./src/styles.css -o ../static/css/dist/styles.css -w"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.9",
    "cross-env": "^7.0.3",
    "daisyui": "^5.7.42",
    "postcss": "^8.4.24",
    "postcss-import": "^17.0.0",
    "postcss-nested": "^8.0.1",
    "postcss-simple-vars": "^7.0.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3"
  }
}
