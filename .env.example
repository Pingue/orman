# Required
SECRET_KEY=change-me-to-a-long-random-string
DOMAIN=orman.example.com
CSRF_TRUSTED_ORIGINS=https://orman.example.com

# Let's Encrypt (production only)
ACME_EMAIL=admin@example.com

# Image (production only — set to your GHCR image)
ORMAN_IMAGE=ghcr.io/pingue/orman:latest

# Optional — defaults shown
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=False

# Email — pick one backend:

# Console (dev default, no config needed)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=orman@example.com
# EMAIL_HOST_PASSWORD=

# Amazon SES (recommended for production)
# EMAIL_BACKEND=django_ses.SESBackend
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SES_REGION_NAME=eu-west-1

DEFAULT_FROM_EMAIL=orman@example.com
