# Required
SECRET_KEY=change-me-to-a-long-random-string
DOMAIN=orman.example.com

# Let's Encrypt (production only)
ACME_EMAIL=admin@example.com

# Image (production only — set to your GHCR image)
ORMAN_IMAGE=ghcr.io/pingue/orman:latest

# Optional — defaults shown
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=False

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=orman@example.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=orman@example.com
